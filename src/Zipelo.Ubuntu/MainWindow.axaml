<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Zipelo.Ubuntu.MainWindow" Title="Zipelo"
    Width="960" Height="720" MinWidth="640" MinHeight="500"
    Background="#F3F6FA" Foreground="#17263C"
    FontFamily="Noto Sans CJK KR, Ubuntu, sans-serif" FontSize="16"
    Closing="OnClosing">
    <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <StackPanel Margin="0,0,0,24" Spacing="8">
            <TextBlock Text="Zipelo" FontSize="36" FontWeight="Bold" />
            <TextBlock Text="파일을 열고, 간편하게 풀어보세요." />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,16">
            <Button x:Name="OpenButton" Content="압축파일 열기" Click="OpenArchive"
                Background="#185ABD" Foreground="White" Margin="0,0,12,8" />
            <Button x:Name="CreateButton" Content="새로 압축하기" Click="CreateArchive" IsEnabled="False" Margin="0,0,12,8"
                ToolTip.Tip="새 파일 저장 기능 연결과 검증을 준비하고 있습니다." />
            <Button x:Name="RetryCreateButton" Content="생성 다시 시도" Click="RetryCreation" IsEnabled="False" Margin="0,0,12,8" />
            <Button Content="압축 풀기" IsEnabled="False" Margin="0,0,12,8"
                ToolTip.Tip="안전한 압축 해제를 검증한 뒤 사용할 수 있습니다." />
        </WrapPanel>
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,16">
            <TextBlock x:Name="ArchiveTitle" Text="아직 열린 압축파일이 없습니다." FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="Availability" TextWrapping="Wrap" />
            <TextBlock Text="새 ZIP 이름 (기존 파일은 덮어쓰지 않습니다.)" />
            <TextBox x:Name="CreationName" Text="새 압축파일.zip" AutomationProperties.Name="새 ZIP 파일 이름" />
            <TextBlock x:Name="CreationSelection" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3" Background="White">
            <ListBox x:Name="Files" AutomationProperties.Name="압축파일 안의 파일 목록">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,140,140" Margin="8,10">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Size}" Margin="12,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Verification}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyState" Text="압축파일을 열면 여기에 파일 목록이 표시됩니다."
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,20,0,0" Spacing="12">
            <TextBlock x:Name="Status" Text="작업 대기 중" TextWrapping="Wrap" AutomationProperties.Name="작업 상태" />
            <ProgressBar x:Name="Progress" IsVisible="False" IsIndeterminate="True" Height="8"
                AutomationProperties.Name="파일 목록 읽기 진행 중" />
            <Button x:Name="StopButton" Content="작업 중지" Click="StopJob" IsEnabled="False"
                HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Window>
