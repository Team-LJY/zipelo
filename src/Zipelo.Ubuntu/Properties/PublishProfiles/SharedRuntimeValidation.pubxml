<Project>
    <PropertyGroup>
        <SelfContained>false</SelfContained>
        <UseAppHost>true</UseAppHost>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishAot>false</PublishAot>
    </PropertyGroup>
    <Target Name="RequireSharedRuntimeAssembler" BeforeTargets="PrepareForPublish">
        <Error Condition="'$(ZipeloSharedRuntimeValidation)' != 'true' Or '$(ZipeloSharedRuntimeAssembler)' != 'true'"
            Text="공유 런타임 후보는 명시적 검증 옵션을 사용해 assemble.py로 준비해야 합니다." />
    </Target>
</Project>
