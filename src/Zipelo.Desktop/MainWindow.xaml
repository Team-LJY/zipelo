<Window x:Class="Zipelo.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Zipelo" Width="980" Height="740" MinWidth="640" MinHeight="520"
    Closing="OnClosing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Content="설치 안내" Click="ShowInstallation" Margin="0" />
            <StackPanel>
                <TextBlock Text="Zipelo" FontSize="36" FontWeight="Bold" />
                <TextBlock Text="파일을 열고, 간편하게 풀어보세요." Margin="0,4,12,0" />
            </StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,20">
            <Button x:Name="OpenButton" Content="압축파일 열기" Click="OpenArchive"
                Background="#185ABD" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,8" />
            <Button x:Name="CreateButton" Content="새로 압축하기" Click="CreateArchive" Margin="0,0,12,8" />
            <Button x:Name="RetryCreateButton" Content="생성 다시 시도" Click="RetryCreation" IsEnabled="False" Margin="0,0,12,8" />
            <Button x:Name="ExtractButton" Content="압축 풀기" Click="ExtractArchive" IsEnabled="False" Margin="0,0,12,8" />
        </WrapPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock x:Name="ArchiveTitle" Text="아직 열린 압축파일이 없습니다." FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="Availability" TextWrapping="Wrap" Text="개발 중인 화면입니다. 압축 엔진 연결 전에는 파일을 처리할 수 없습니다."
                Margin="0,8,0,0" />
        </StackPanel>
        <Grid Grid.Row="3" Background="White">
            <DataGrid x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True"
                CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                RowHeaderWidth="0" BorderBrush="#CFD7E3" RowHeight="40"
                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                AutomationProperties.Name="압축파일 안의 파일 목록">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="파일 이름" Binding="{Binding Name}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="크기" Binding="{Binding Size}" Width="120" />
                    <DataGridTextColumn Header="검증 상태" Binding="{Binding Verification}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyState" Text="압축파일을 열면 여기에 파일 목록이 표시됩니다."
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,20,0,0">
            <TextBlock x:Name="Status" Text="작업 대기 중" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="CreationSelection" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock x:Name="ResultSummary" Margin="0,8,0,0" />
            <ProgressBar x:Name="Progress" Height="8" Margin="0,12,0,16" Minimum="0" Maximum="100"
                AutomationProperties.Name="작업 진행률" />
            <Button x:Name="StopButton" Content="작업 중지" Click="StopJob" IsEnabled="False" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Window>
