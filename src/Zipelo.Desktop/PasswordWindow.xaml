<Window x:Class="Zipelo.Desktop.PasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="암호 입력" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner" MinWidth="400">
    <StackPanel Margin="28" MaxWidth="460">
        <TextBlock Text="이 파일의 암호를 입력하세요." FontSize="20" FontWeight="SemiBold" />
        <Label Content="암호" Target="{Binding ElementName=Secret}" Margin="0,16,0,0" />
        <PasswordBox x:Name="Secret" MinHeight="44" Padding="8" MaxLength="1024"
            AutomationProperties.Name="압축파일 암호" />
        <TextBlock Text="암호를 저장하지 않습니다." Margin="0,12,0,20" />
        <WrapPanel>
            <Button Content="확인" IsDefault="True" Click="AcceptPassword" />
            <Button Content="취소" IsCancel="True" />
        </WrapPanel>
    </StackPanel>
</Window>
