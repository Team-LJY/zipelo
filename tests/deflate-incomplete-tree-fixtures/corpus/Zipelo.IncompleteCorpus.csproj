<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../Spec.cs" />
        <Compile Include="../FixtureWriter.cs" />
        <Compile Include="../Fixtures.cs" />
        <Compile Include="Program.cs" />
        <Compile Include="../frozen-pr23/Spec.cs" />
        <Compile Include="../frozen-pr23/FixtureWriter.cs" />
        <Compile Include="../frozen-pr23/Fixtures.cs" />
        <None Include="../policy-expectations.json" Link="policy-expectations.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../frozen-pr23/expectations.json" Link="expectations.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
