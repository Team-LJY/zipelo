<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Zipelo.Experimental.DeflateStatefulValidation</AssemblyName>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../deflate-history-validation-probe/Zipelo.HistoryProbe.csproj" Aliases="history" />
        <Compile Include="HistoryAliases.cs" />
        <Compile Include="Fixtures.cs" />
        <Compile Include="StateDriver.cs" />
        <Compile Include="Program.cs" />
    </ItemGroup>
</Project>
