<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Zipelo.Experimental.DeflateTreeValidation</AssemblyName>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="library/Zipelo.TreeCandidate.csproj" />
        <Compile Include="Program.cs" />
        <Compile Include="ExtraFixtures.cs" />
        <Compile Include="../dynamic-deflate-corpus/Corpus.cs" Link="Pinned/Corpus.cs" />
        <Compile Include="../dynamic-deflate-corpus/FixtureWriter.cs" Link="Pinned/FixtureWriter.cs" />
    </ItemGroup>
</Project>
