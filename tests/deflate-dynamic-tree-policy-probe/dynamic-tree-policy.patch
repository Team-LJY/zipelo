+		private enum TreePurpose
+		{
+			Codes,
+			Lens,
+			Dists
+		}
+
+		private static void ValidateTree(IList<byte> lengths, TreePurpose purpose)
+		{
+			int maxBits = purpose == TreePurpose.Codes ? 7 : 15;
+			int[] counts = new int[maxBits + 1];
+			int active = 0;
+
+			for (int i = 0; i < lengths.Count; i++)
+			{
+				int bits = lengths[i];
+				if (bits > maxBits)
+				{
+					throw new StreamDecodingException("Invalid " + purpose + " Huffman code length");
+				}
+				if (bits != 0)
+				{
+					counts[bits]++;
+					active++;
+				}
+			}
+
+			int left = 1;
+			for (int bits = 1; bits <= maxBits; bits++)
+			{
+				left = (left << 1) - counts[bits];
+				if (left < 0)
+				{
+					throw new StreamDecodingException("Oversubscribed " + purpose + " Huffman tree");
+				}
+			}
+
+			if (purpose == TreePurpose.Lens && (lengths.Count <= 256 || lengths[256] == 0))
+			{
+				throw new StreamDecodingException("Inflater dynamic header end-of-block code missing");
+			}
+			if (left == 0)
+			{
+				return;
+			}
+			if (purpose == TreePurpose.Lens && active == 1 && lengths[256] == 1)
+			{
+				return;
+			}
+			if (purpose == TreePurpose.Dists && (active == 0 || (active == 1 && counts[1] == 1)))
+			{
+				return;
+			}
+
+			throw new StreamDecodingException("Incomplete " + purpose + " Huffman tree");
+		}
