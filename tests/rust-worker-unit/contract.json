    "provenance": {
        "origin": "New synthetic byte builders and direct function tests; existing fixtures and expectations unchanged",
        "crcVector": "ASCII 123456789 -> CRC32 cbf43926; empty input -> 0. No CRC implementation copied.",
        "deflateVector": "RFC 1951 final stored block: 01 09 00 f6 ff followed by ASCII 123456789. No compressor/decoder implementation added.",
        "wire": "Frozen PR10 ZXE2/ZXR2/ZIP2 layouts and original PR28 contract",
        "dependencies": "Only existing crate dependencies, no added dev-dependencies"
    },
    "limits": [
        "74 named Rust test functions; 8 new regressions, 66 existing functions preserved. Loop rows are subcases, not additional named tests.",
        "73 assertion tests and one policy observation. Deflate packed-tail acceptance/rejection is printed with --nocapture and is not evidence of C# policy compatibility.",
        "Production changes are limited to Unix type precedence, bounded duration parsing and borrowed nested-error classification. Existing test assertions are preserved; execution is pending.",
        "Allocator activity is not instrumented. Oversized JSON/Source/range requests are checked by no-body-read/no-request observations plus static preallocation review.",
        "21 MiB wire cap is unreachable through the public Frames API under current stricter caps: <=16 MiB data + <=65536*64 header bytes + <=1024*16 item metadata bytes +1 completion byte <21 MiB. No claimed direct branch hit.",
        "Generic crate integrity errors do not establish a precise parser step or actual EOF. Explicit short transport/Source reads are tested separately.",
        "No process spawn in direct tests: stdout EOF and exit status, host publication/cancellation/cleanup and Windows hang remain separate comparison-harness responsibilities.",
        "Budget deadline timing is not tested by sleeps; deterministic limit validation and sticky budget failure are covered.",
        "item_id is exercised only in its reachable bounded ordinal domain 0..1023.",
        "Frames is not claimed to become permanently faulted after every API misuse. Error paths tested here emit no successful completion; worker callers return on errors."
    ],
    "commands": [
        "cargo test --locked --offline --manifest-path experiments/rust-core/Cargo.toml --test worker_unit --no-run",
        "timeout --signal=TERM --kill-after=5s 60s cargo test --locked --offline --manifest-path experiments/rust-core/Cargo.toml --test worker_unit -- --test-threads=1 --nocapture"
    ],
    "centralPrerequisites": [
        "Use centrally resolved actual Cargo.lock with matching dependency manifest; no handmade lock.",
        "Record new source head, lock hash, toolchain, target, command exit and external process cleanup.",
        "Old c9a2747d build results do not validate this test head. Stop on timeout and confirm owned process cleanup."
    ],
    "reviewCorrections": {
        "unixTypes": "Non-regular/non-directory Unix types remain special entries even with a trailing slash. Listing reports Kind=4; streaming rejects before BeginItem. Host independently blocks publication, not a demonstrated filesystem escape.",
