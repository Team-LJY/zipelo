<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Zipelo.Experimental.SharpZipLibHistoryProbe</AssemblyName>
        <RootNamespace>Zipelo.Experimental</RootNamespace>
        <IsPackable>false</IsPackable>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <Deterministic>true</Deterministic>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Program.cs" />
        <Compile Include="RawProbe.cs" />
        <Compile Include="vendor/Zip/Compression/Inflater.cs" />
        <Compile Include="vendor/Zip/Compression/InflaterDynHeader.cs" />
        <Compile Include="vendor/Zip/Compression/InflaterHuffmanTree.cs" />
        <Compile Include="vendor/Zip/Compression/Deflater.cs" />
        <Compile Include="vendor/Zip/Compression/DeflaterEngine.cs" />
        <Compile Include="vendor/Zip/Compression/DeflaterConstants.cs" />
        <Compile Include="vendor/Zip/Compression/DeflaterHuffman.cs" />
        <Compile Include="vendor/Zip/Compression/DeflaterPending.cs" />
        <Compile Include="vendor/Zip/Compression/PendingBuffer.cs" />
        <Compile Include="vendor/Zip/Compression/Streams/OutputWindow.cs" />
        <Compile Include="vendor/Zip/Compression/Streams/StreamManipulator.cs" />
        <Compile Include="vendor/Checksum/Adler32.cs" />
        <Compile Include="vendor/Checksum/IChecksum.cs" />
        <Compile Include="vendor/Core/Exceptions/SharpZipBaseException.cs" />
        <Compile Include="vendor/Core/Exceptions/StreamDecodingException.cs" />
        <Compile Include="vendor/Core/Exceptions/ValueOutOfRangeException.cs" />
    </ItemGroup>
</Project>
