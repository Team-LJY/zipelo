Unicode true
!include "MUI2.nsh"
!include "nsDialogs.nsh"
!include "LogicLib.nsh"
!include "x64.nsh"
Name "Zipelo - 개발 검증 설치 초안"
OutFile "Zipelo-@VERSION@-win-x64-draft.exe"
InstallDir "$LOCALAPPDATA\Programs\Zipelo-Draft"
RequestExecutionLevel user
SetCompressor zlib
ShowInstDetails show
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_INSTFILES
Page custom FinishCreate
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "Korean"
Var Dialog
Var SettingsButton

Function .onInit
    ${IfNot} ${RunningX64}
        MessageBox MB_OK "이 설치 초안은 Windows x64 전용입니다."
        Abort
    ${EndIf}
    SetShellVarContext current
    SetRegView 64
FunctionEnd

Section "Zipelo"
    SetShellVarContext current
    SetRegView 64
    IfFileExists "$INSTDIR\Uninstall.exe" 0 +3
        MessageBox MB_OK "기존 개발 초안을 먼저 제거하세요. 업데이트 설치는 아직 검증 전입니다."
        Abort
@FILES@
    WriteUninstaller "$INSTDIR\Uninstall.exe"
    CreateDirectory "$SMPROGRAMS\Zipelo-Draft"
    CreateShortcut "$SMPROGRAMS\Zipelo-Draft\Zipelo.lnk" "$INSTDIR\Zipelo.exe"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Zipelo-Draft" "DisplayName" "Zipelo 개발 검증 초안"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Zipelo-Draft" "DisplayVersion" "@VERSION@"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Zipelo-Draft" "UninstallString" '$\"$INSTDIR\Uninstall.exe$\"'
@REGISTER@
SectionEnd

Function FinishCreate
    GetDlgItem $0 $HWNDPARENT 1
    SendMessage $0 ${WM_SETTEXT} 0 "STR:나중에"
    GetDlgItem $0 $HWNDPARENT 3
    EnableWindow $0 0
    nsDialogs::Create 1018
    Pop $Dialog
    ${If} $Dialog == error
        Abort
    ${EndIf}
    ${NSD_CreateLabel} 0 0 100% 38u "개발 검증 설치가 끝났습니다. 기본 앱은 설정 화면에서 직접 선택합니다. 검증된 형식만 연결 후보로 등록됩니다."
    Pop $0
    ${NSD_CreateButton} 0 52u 100% 18u "기본 앱 설정 열기"
    Pop $SettingsButton
    ${NSD_OnClick} $SettingsButton OpenSettings
    nsDialogs::Show
FunctionEnd

Function OpenSettings
    Pop $0
    ExecShell "open" "ms-settings:defaultapps"
FunctionEnd

Section "Uninstall"
    SetShellVarContext current
    SetRegView 64
@UNREGISTER@
    DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Zipelo-Draft"
    Delete "$SMPROGRAMS\Zipelo-Draft\Zipelo.lnk"
    RMDir "$SMPROGRAMS\Zipelo-Draft"
@DELETE@
    Delete "$INSTDIR\Uninstall.exe"
    RMDir "$INSTDIR"
SectionEnd
